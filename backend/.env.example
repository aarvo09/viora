# VIORA backend configuration.
# Copy to `.env` and fill in. NEVER commit `.env`.
#
# Nothing in this file may ever be copied into patient-app/ or counsellor-web/.
# The phone talks to this backend; only this backend talks to Sarvam.

APP_ENV=development
LOG_LEVEL=INFO

DATABASE_URL=sqlite:///./viora.db

# --- Sarvam (SERVER-SIDE ONLY) ---
SARVAM_API_KEY=change-me
# --- Auth ---
# Generate a real one:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# --- CORS ---
# Explicit origins only, never "*". Add your laptop's LAN IP if you open the
# dashboard from another machine, e.g. http://192.168.1.20:5173
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
